<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Centered Header Title (Long-pressable) -->
                <LinearLayout
                    android:id="@+id/header_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/iv_bt_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/app_name"
                        android:textColor="@color/text_light"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#2E2E2E" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/status_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Driving D-Pad Card (Center Stage) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:columnCount="3"
                android:padding="20dp"
                android:rowCount="3">

                <!-- Row 1: Up-Left, Forward, Up-Right -->
                <ImageButton
                    android:id="@+id/btn_up_left"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Up Left"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_up_left" />

                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Forward"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_up" />

                <ImageButton
                    android:id="@+id/btn_up_right"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Up Right"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_up_right" />

                <!-- Row 2: Left, Center/Stop, Right -->
                <ImageButton
                    android:id="@+id/btn_left"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Left"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_left" />

                <ImageButton
                    android:id="@+id/btn_center"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_stop_button"
                    android:contentDescription="Stop"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_stop_center" />

                <ImageButton
                    android:id="@+id/btn_right"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Right"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right" />

                <!-- Row 3: Down-Left, Backward, Down-Right -->
                <ImageButton
                    android:id="@+id/btn_down_left"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Down Left"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_down_left" />

                <ImageButton
                    android:id="@+id/btn_backward"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Backward"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_down" />

                <ImageButton
                    android:id="@+id/btn_down_right"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_dpad_button"
                    android:contentDescription="Down Right"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_down_right" />
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Speed Control Card (Bottom) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed: 100%"
                    android:textColor="@color/text_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sb_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Crash Prevention Toggle Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/crash_prevention"
                    android:textColor="@color/text_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_crash_prevention"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Communication Log Card (Opened via Long Press on Header) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_communication_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/comm_log_title"
                        android:textColor="@color/text_light"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_log"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_log"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/sv_log_container"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#0A0D12"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_log_console"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="-- Communication Log --\n"
                        android:textColor="#00E676"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
